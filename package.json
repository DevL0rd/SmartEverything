{
  "name": "smarteverything",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "build:go2rtc": "tsx tooling/go2rtc/build.ts",
    "build:web": "pnpm --filter @smarteverything/app run export:web",
    "check:commits": "commitlint --from=HEAD~1 --to=HEAD --verbose",
    "check:cycles": "dpdm --no-warning --no-tree --exit-code circular:1 packages/*/src/index.ts 'packages/flow/src/**/*.ts' apps/hub/src/main.ts 'apps/app/app/**/*.tsx'",
    "check:duplication": "jscpd",
    "check:expo": "pnpm --filter @smarteverything/app exec npx expo-doctor",
    "check:licenses": "tsx tooling/check-licenses.ts",
    "generate:licenses": "tsx tooling/generate-licenses.ts",
    "check:links": "markdown-link-check --quiet -c .markdown-link-check.json README.md docs/STANDARDS.md",
    "check:pinned": "tsx tooling/check-pinned-versions.ts",
    "check:secrets": "gitleaks detect --no-banner --redact",
    "check:spelling": "cspell \"**/*.{ts,tsx,md,json,yaml,yml}\" --no-progress --no-summary --cache --cache-location .cache/cspell/",
    "check:types-coverage": "tsx tooling/check-type-coverage.ts",
    "check:unused": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0 --cache --cache-location .cache/eslint/",
    "test": "vitest run",
    "test:contracts": "vitest run --project contracts",
    "test:coverage": "vitest run --coverage --project logging --project domain --project xiaomi --project ble --project ipp --project tuya --project smartthings --project shelly --project flow",
    "test:guards": "vitest run --project guards",
    "test:mutation": "stryker run",
    "test:unit": "vitest run --project logging --project domain --project xiaomi --project ble --project ipp --project tuya --project smartthings --project shelly --project flow --project hub --project desktop --project app",
    "typecheck": "tsc --build --force",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run check:types-coverage && pnpm run check:cycles && pnpm run check:unused && pnpm run check:spelling && pnpm run check:licenses && pnpm run check:links && pnpm run test:unit && pnpm run test:coverage && pnpm run test:contracts && pnpm run test:guards && pnpm run check:pinned && pnpm run check:duplication && pnpm run test:mutation"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@smarteverything/domain": "workspace:*",
    "@smarteverything/logging": "workspace:*",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "cspell": "10.1.1",
    "dpdm": "4.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.9.0",
    "globals": "17.11.0",
    "jscpd": "5.0.16",
    "knip": "6.32.2",
    "markdown-link-check": "3.15.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "type-coverage": "2.30.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "zod": "4.4.3"
  }
}
