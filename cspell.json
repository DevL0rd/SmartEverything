    "packages/xiaomi/test/fixtures/**",
    "packages/xiaomi/src/vacuum/pv11gl-catalog.json",
    "**/out/**",
    "apps/app/android/**",
    "apps/app/assets/licences.json",
    "**/build/**"
  ],
  "ignoreRegExpList": ["GHSA(-[a-z0-9]{4}){3}"],
  "overrides": [
    {
      "filename": "**/apps/hub/src/claude/safe-{programs,git}.ts",
      "ignoreRegExpList": ["/'[^'\\s]+'/g"]
    },
    {
      "filename": "**/apps/hub/{src,test}/transcripts/heard-text*.ts",
      "ignoreRegExpList": ["/'[^']*'/g"]
    }
  ]
