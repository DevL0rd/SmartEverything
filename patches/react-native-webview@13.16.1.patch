@@ -0,0 +1,42 @@
+package com.reactnativecommunity.webview
+
+import android.webkit.WebView
+import androidx.webkit.ProfileStore
+import androidx.webkit.WebViewCompat
+import androidx.webkit.WebViewFeature
+import java.util.UUID
+import java.util.WeakHashMap
+
+internal object RNCBrowserProfiles {
+    private const val PREFIX = "smarteverything-browser-"
+    private val active = WeakHashMap<WebView, String>()
+    private var initialized = false
+
+    @JvmStatic
+    fun policy(): Double = if (WebViewFeature.isFeatureSupported(WebViewFeature.MULTI_PROFILE)) 2.0 else 0.0
+
+    fun attach(view: WebView) {
+        if (!WebViewFeature.isFeatureSupported(WebViewFeature.MULTI_PROFILE)) {
+            throw IllegalStateException("The Android browser requires isolated WebView profile support.")
+        }
+        if (!initialized) {
+            val store = ProfileStore.getInstance()
+            for (name in store.allProfileNames.filter { it.startsWith(PREFIX) }) {
+                check(store.deleteProfile(name)) { "A previous browser profile could not be deleted." }
+            }
+            initialized = true
+        }
+        check(!active.containsKey(view)) { "This browser already has an isolated profile." }
+        val name = PREFIX + UUID.randomUUID().toString()
+        WebViewCompat.setProfile(view, name)
+        active[view] = name
+    }
+
+    fun release(view: WebView) {
+        if (!WebViewFeature.isFeatureSupported(WebViewFeature.MULTI_PROFILE)) {
+            throw IllegalStateException("The Android browser lost isolated WebView profile support.")
+        }
+        val name = checkNotNull(active.remove(view)) { "This browser has no isolated profile to release." }
+        check(ProfileStore.getInstance().deleteProfile(name)) { "The isolated browser profile could not be deleted." }
+    }
+}
