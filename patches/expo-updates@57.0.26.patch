diff --git a/android/src/main/java/expo/modules/updates/selectionpolicy/UpdateLaunchApproval.kt b/android/src/main/java/expo/modules/updates/selectionpolicy/UpdateLaunchApproval.kt
new file mode 100644
index 0000000000000000000000000000000000000000..b21c832710cabc46a22c5c74cf8245fe306c88bb
--- /dev/null
+++ b/android/src/main/java/expo/modules/updates/selectionpolicy/UpdateLaunchApproval.kt
@@ -0,0 +1,47 @@
+package expo.modules.updates.selectionpolicy
+
+import android.content.Context
+import expo.modules.updates.db.entity.UpdateEntity
+import org.json.JSONObject
+import java.util.UUID
+
+internal class UpdateLaunchApproval(context: Context) {
+  private val preferences = context.getSharedPreferences("SmartEverythingUpdateLaunch", Context.MODE_PRIVATE)
+
+  fun approve(updateId: UUID?) {
+    check(preferences.edit().putString(APPROVED_UPDATE, updateId?.toString()).commit()) {
+      "Could not save update launch approval"
+    }
+  }
+
+  private fun eligible(update: UpdateEntity, embeddedId: UUID?, approved: String?): Boolean =
+    update.id == embeddedId || update.successfulLaunchCount > 0 || update.id.toString() == approved
+
+  fun policy(base: SelectionPolicy, embeddedId: UUID?): SelectionPolicy = SelectionPolicy(
+    object : LauncherSelectionPolicy {
+      override fun selectUpdateToLaunch(updates: List<UpdateEntity>, filters: JSONObject?): UpdateEntity? {
+        val approved = preferences.getString(APPROVED_UPDATE, null)
+        return base.selectUpdateToLaunch(updates.filter { eligible(it, embeddedId, approved) }, filters)
+          ?: updates.firstOrNull { it.id == embeddedId }
+      }
+    },
+    object : LoaderSelectionPolicy by base.loaderSelectionPolicy {
+      override fun shouldLoadNewUpdate(newUpdate: UpdateEntity?, launchedUpdate: UpdateEntity?, filters: JSONObject?): Boolean =
+        (newUpdate != null && newUpdate.id == embeddedId && launchedUpdate == null) ||
+          base.shouldLoadNewUpdate(newUpdate, launchedUpdate, filters)
+    },
+    object : ReaperSelectionPolicy {
+      override fun selectUpdatesToDelete(updates: List<UpdateEntity>, launchedUpdate: UpdateEntity?, filters: JSONObject?): List<UpdateEntity> {
+        if (launchedUpdate == null) return emptyList()
+        val approved = preferences.getString(APPROVED_UPDATE, null)
+        val (eligible, staged) = updates.partition { eligible(it, embeddedId, approved) }
+        return base.selectUpdatesToDelete(eligible, launchedUpdate, filters).filterNot { it.id == embeddedId } +
+          staged.filter { it.scopeKey == launchedUpdate.scopeKey && it.commitTime.before(launchedUpdate.commitTime) }
+      }
+    }
+  )
+
+  private companion object {
+    const val APPROVED_UPDATE = "approvedUpdate"
+  }
+}
