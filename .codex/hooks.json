{
  "description": "Reuse repository edit checks for Codex patches and dependency changes.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tooling/codex-hook.ts\" snapshot",
            "timeout": 300,
            "statusMessage": "Recording type errors before the patch"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tooling/claude-hook.ts\" snapshot",
            "timeout": 300,
            "statusMessage": "Checking dependency changes"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tooling/codex-hook.ts\" edit",
            "timeout": 300,
            "statusMessage": "Checking patched files"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tooling/codex-hook.ts\" bash-done",
            "timeout": 300,
            "statusMessage": "Checking changed dependency manifests"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tooling/claude-hook.ts\" end",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
