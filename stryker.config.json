{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts"
  },
  "reporters": ["progress", "clear-text", "html"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "packages/logging/src/**/*.ts",
    "!packages/logging/src/index.ts",
    "packages/domain/src/**/*.ts",
    "!packages/domain/src/index.ts",
    "packages/xiaomi/src/**/*.ts",
    "!packages/xiaomi/src/index.ts",
    "packages/ble/src/**/*.ts",
    "!packages/ble/src/index.ts",
    "packages/tuya/src/**/*.ts",
    "!packages/tuya/src/index.ts",
    "packages/smartthings/src/**/*.ts",
    "!packages/smartthings/src/index.ts"
  ],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "plugins": ["@stryker-mutator/vitest-runner"],
  "ignorePatterns": [".claude", ".agents", "dist", "dist-types", "coverage", "reports"]
}
