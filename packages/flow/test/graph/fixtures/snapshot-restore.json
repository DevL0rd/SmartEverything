{
  "version": 3,
  "kind": "automation",
  "triggers": [
    {
      "id": "11000000-0000-4000-8000-000000000005",
      "key": "tick",
      "kind": "trigger.interval",
      "ports": { "every": { "lit": 60000 } }
    }
  ],
  "inputs": [],
  "outputs": [],
  "variables": [],
  "body": {
    "nodes": [
      {
        "id": "11000000-0000-4000-8000-000000000001",
        "key": "saved",
        "kind": "device.snapshot",
        "ports": { "target": { "lit": { "target": "hall" } } }
      },
      {
        "id": "11000000-0000-4000-8000-000000000002",
        "key": "red",
        "kind": "device.set",
        "ports": {
          "target": { "lit": { "target": "hall" } },
          "control": { "lit": "color" },
          "to": { "lit": "red" }
        }
      },
      {
        "id": "11000000-0000-4000-8000-000000000003",
        "key": "dim",
        "kind": "device.set",
        "ports": {
          "target": { "lit": { "target": "hall" } },
          "control": { "lit": "level" },
          "to": { "lit": 5 }
        }
      },
      {
        "id": "11000000-0000-4000-8000-000000000004",
        "key": "back",
        "kind": "device.restore",
        "ports": { "snapshot": { "wire": { "from": "saved", "port": "snapshot" } } }
      }
    ]
  },
  "policy": { "mode": "single" }
}
