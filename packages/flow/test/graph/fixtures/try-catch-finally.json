{
  "version": 3,
  "kind": "automation",
  "triggers": [
    {
      "id": "07000000-0000-4000-8000-000000000010",
      "key": "tick",
      "kind": "trigger.interval",
      "ports": { "every": { "lit": 60000 } }
    }
  ],
  "inputs": [],
  "outputs": [],
  "variables": [],
  "body": {
    "nodes": [
      {
        "id": "07000000-0000-4000-8000-000000000008",
        "key": "guarded",
        "kind": "flow.try",
        "ports": {},
        "scopes": {
          "try": {
            "nodes": [
              {
                "id": "07000000-0000-4000-8000-000000000001",
                "key": "inside",
                "kind": "debug.log",
                "ports": { "message": { "lit": "in try" } }
              },
              {
                "id": "07000000-0000-4000-8000-000000000002",
                "key": "boom",
                "kind": "flow.fail",
                "ports": { "class": { "lit": "Failed" }, "message": { "lit": "boom" } }
              }
            ]
          },
          "finally": {
            "nodes": [
              {
                "id": "07000000-0000-4000-8000-000000000003",
                "key": "cleanup",
                "kind": "notify.feed",
                "ports": { "message": { "lit": "cleanup" } }
              }
            ]
          }
        },
        "catches": [
          {
            "id": "07000000-0000-4000-8000-000000000004",
            "classes": ["Unreachable"],
            "scope": {
              "nodes": [
                {
                  "id": "07000000-0000-4000-8000-000000000005",
                  "key": "away",
                  "kind": "notify.feed",
                  "ports": { "message": { "lit": "unreachable" } }
                }
              ]
            }
          },
          {
            "id": "07000000-0000-4000-8000-000000000006",
            "scope": {
              "nodes": [
                {
                  "id": "07000000-0000-4000-8000-000000000007",
                  "key": "caught",
                  "kind": "debug.log",
                  "ports": { "message": { "lit": "caught" } }
                }
              ]
            }
          }
        ]
      },
      {
        "id": "07000000-0000-4000-8000-000000000009",
        "key": "after",
        "kind": "notify.feed",
        "ports": { "message": { "lit": "after try" } }
      }
    ]
  },
  "policy": { "mode": "single" }
}
