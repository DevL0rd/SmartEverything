{
  "version": 3,
  "kind": "automation",
  "triggers": [
    {
      "id": "15000000-0000-4000-8000-000000000008",
      "key": "tick",
      "kind": "trigger.interval",
      "ports": { "every": { "lit": 60000 } }
    }
  ],
  "inputs": [],
  "outputs": [],
  "variables": [],
  "body": {
    "nodes": [
      {
        "id": "15000000-0000-4000-8000-000000000006",
        "key": "decide",
        "kind": "flow.if",
        "ports": {},
        "branches": [
          {
            "id": "15000000-0000-4000-8000-000000000001",
            "when": { "lit": true },
            "scope": {
              "nodes": [
                {
                  "id": "15000000-0000-4000-8000-000000000002",
                  "key": "allowed",
                  "kind": "logic.compare",
                  "ports": {
                    "a": { "wire": { "from": "trigger", "port": "tick" } },
                    "op": { "lit": "gt" },
                    "b": { "lit": 1 }
                  }
                },
                {
                  "id": "15000000-0000-4000-8000-000000000003",
                  "key": "gate",
                  "kind": "flow.guard",
                  "ports": {
                    "condition": { "wire": { "from": "allowed", "port": "result" } },
                    "quietly": { "lit": false }
                  }
                },
                {
                  "id": "15000000-0000-4000-8000-000000000004",
                  "key": "inside",
                  "kind": "device.set",
                  "ports": {
                    "target": { "lit": { "target": "hall" } },
                    "control": { "lit": "level" },
                    "to": { "lit": 30 }
                  }
                }
              ]
            }
          }
        ],
        "scopes": {
          "else": {
            "nodes": [
              {
                "id": "15000000-0000-4000-8000-000000000005",
                "key": "other",
                "kind": "debug.log",
                "ports": { "message": { "lit": "else" } }
              }
            ]
          }
        }
      },
      {
        "id": "15000000-0000-4000-8000-000000000007",
        "key": "after",
        "kind": "notify.feed",
        "ports": { "message": { "lit": "after the row" } }
      }
    ]
  },
  "policy": { "mode": "single" }
}
