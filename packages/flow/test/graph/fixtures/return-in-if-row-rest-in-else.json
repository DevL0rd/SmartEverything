{
  "version": 3,
  "kind": "automation",
  "triggers": [
    {
      "id": "17000000-0000-4000-8000-000000000010",
      "key": "tick",
      "kind": "trigger.interval",
      "ports": { "every": { "lit": 60000 } }
    }
  ],
  "inputs": [],
  "outputs": [],
  "variables": [],
  "body": {
    "nodes": [
      {
        "id": "17000000-0000-4000-8000-000000000001",
        "key": "quiet",
        "kind": "logic.compare",
        "ports": {
          "a": { "wire": { "from": "trigger", "port": "tick" } },
          "op": { "lit": "lt" },
          "b": { "lit": 2 }
        }
      },
      {
        "id": "17000000-0000-4000-8000-000000000002",
        "key": "decide",
        "kind": "flow.if",
        "ports": {},
        "branches": [
          {
            "id": "17000000-0000-4000-8000-000000000003",
            "when": { "wire": { "from": "quiet", "port": "result" } },
            "scope": {
              "nodes": [
                {
                  "id": "17000000-0000-4000-8000-000000000004",
                  "key": "hush",
                  "kind": "notify.feed",
                  "ports": { "message": { "lit": "quiet" } }
                },
                {
                  "id": "17000000-0000-4000-8000-000000000005",
                  "key": "leave",
                  "kind": "flow.return",
                  "ports": {}
                }
              ]
            }
          }
        ],
        "scopes": {
          "else": {
            "nodes": [
              {
                "id": "17000000-0000-4000-8000-000000000006",
                "key": "together",
                "kind": "flow.parallel",
                "ports": {},
                "scopes": {
                  "lights": {
                    "nodes": [
                      {
                        "id": "17000000-0000-4000-8000-000000000007",
                        "key": "flash",
                        "kind": "device.set",
                        "ports": {
                          "target": { "lit": { "target": "hall" } },
                          "control": { "lit": "color" },
                          "to": { "lit": "red" }
                        }
                      }
                    ]
                  },
                  "feed": {
                    "nodes": [
                      {
                        "id": "17000000-0000-4000-8000-000000000008",
                        "key": "tell",
                        "kind": "notify.feed",
                        "ports": { "message": { "lit": "baby crying" } }
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    ]
  },
  "policy": { "mode": "single" }
}
