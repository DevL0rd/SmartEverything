+func (p *Producer) removeSender(track *core.Receiver) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+
+	for i, sender := range p.senders {
+		if sender == track {
+			p.senders = append(p.senders[:i], p.senders[i+1:]...)
+			return
+		}
+	}
+}
