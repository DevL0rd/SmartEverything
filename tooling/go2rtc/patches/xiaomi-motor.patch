+package xiaomi
+
+import (
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/AlexxIT/go2rtc/internal/streams"
+	"github.com/AlexxIT/go2rtc/pkg/core"
+)
+
+type fakeMotor struct {
+	core.Connection
+	operations []int
+	err        error
+}
+
+func (f *fakeMotor) GetTrack(*core.Media, *core.Codec) (*core.Receiver, error) {
+	return nil, errors.New("no tracks")
+}
+
+func (f *fakeMotor) Start() error {
+	return nil
+}
+
+func (f *fakeMotor) Motor(operation int) error {
+	f.operations = append(f.operations, operation)
+	return f.err
+}
+
+func motorRequest(method, query string) *httptest.ResponseRecorder {
+	w := httptest.NewRecorder()
+	apiMotor(w, httptest.NewRequest(method, "/api/xiaomi/motor?"+query, nil))
+	return w
+}
+
+func TestMotorMovesTheConnectedSource(t *testing.T) {
+	stream, _ := streams.New("motor-ok")
+	defer streams.Delete("motor-ok")
+	motor := &fakeMotor{}
+	stream.AddProducer(motor)
+
+	for _, operation := range []string{"1", "2", "3", "4", "5"} {
+		if w := motorRequest("POST", "src=motor-ok&operation="+operation); w.Code != http.StatusOK {
+			t.Fatalf("operation %s: status %d, body %q", operation, w.Code, w.Body.String())
+		}
+	}
+	if len(motor.operations) != 5 || motor.operations[0] != 1 || motor.operations[4] != 5 {
+		t.Fatalf("operations sent: %v", motor.operations)
+	}
+}
+
+func TestMotorRefusals(t *testing.T) {
+	idle, _ := streams.New("motor-idle")
+	defer streams.Delete("motor-idle")
+	_ = idle
+	failing, _ := streams.New("motor-failing")
+	defer streams.Delete("motor-failing")
+	failing.AddProducer(&fakeMotor{err: errors.New("cs2: can't send command")})
+
+	cases := []struct {
+		method, query string
+		status        int
+	}{
+		{"GET", "src=motor-idle&operation=1", http.StatusMethodNotAllowed},
+		{"POST", "src=motor-idle&operation=0", http.StatusBadRequest},
+		{"POST", "src=motor-idle&operation=6", http.StatusBadRequest},
+		{"POST", "src=motor-idle&operation=1abc", http.StatusBadRequest},
+		{"POST", "src=motor-idle", http.StatusBadRequest},
+		{"POST", "src=missing&operation=1", http.StatusNotFound},
+		{"POST", "src=motor-idle&operation=1", http.StatusConflict},
+		{"POST", "src=motor-failing&operation=1", http.StatusBadGateway},
+	}
+	for _, c := range cases {
+		if w := motorRequest(c.method, c.query); w.Code != c.status {
+			t.Errorf("%s %s: status %d, want %d (%q)", c.method, c.query, w.Code, c.status, w.Body.String())
+		}
+	}
+}
