+package cs2
+
+import (
+	"encoding/binary"
+	"testing"
+)
+
+func TestReadCommandRefusesShortCommands(t *testing.T) {
+	c := &Conn{channels: [4]*dataChannel{newDataChannel(0, 10), nil, nil, nil}}
+	c.channels[0].popBuf <- []byte{1, 2}
+	if _, _, err := c.ReadCommand(); err == nil {
+		t.Fatal("a two byte command was accepted")
+	}
+
+	full := binary.LittleEndian.AppendUint32(nil, 0x113)
+	c.channels[0].popBuf <- append(full, '{', '}')
+	cmd, data, err := c.ReadCommand()
+	if err != nil || cmd != 0x113 || string(data) != "{}" {
+		t.Fatalf("ReadCommand = %x, %q, %v", cmd, data, err)
+	}
+}
