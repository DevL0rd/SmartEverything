+}
+
+type motorer interface {
+	Motor(operation int) error
+}
+
+func apiMotor(w http.ResponseWriter, r *http.Request) {
+	if r.Method != "POST" {
+		http.Error(w, "POST only", http.StatusMethodNotAllowed)
+		return
+	}
+	query := r.URL.Query()
+	operation, err := strconv.Atoi(query.Get("operation"))
+	if err != nil || operation < 1 || operation > 5 {
+		http.Error(w, "operation must be 1 (left), 2 (right), 3 (up), 4 (down) or 5 (calibrate)", http.StatusBadRequest)
+		return
+	}
+	name := query.Get("src")
+	stream := streams.Get(name)
+	if stream == nil {
+		http.Error(w, fmt.Sprintf("xiaomi: motor: no stream %q", name), http.StatusNotFound)
+		return
+	}
+	for _, conn := range stream.Conns() {
+		if m, ok := conn.(motorer); ok {
+			if err = m.Motor(operation); err != nil {
+				http.Error(w, "xiaomi: motor: "+err.Error(), http.StatusBadGateway)
+			}
+			return
+		}
+	}
+	http.Error(w, fmt.Sprintf("xiaomi: motor: stream %q has no connected source with a motor", name), http.StatusConflict)
 }
 
