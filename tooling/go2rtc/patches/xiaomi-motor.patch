+package miss
+
+import (
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/pkg/xiaomi/crypto"
+)
+
+type fakeConn struct {
+	replies  int
+	written  [][]byte
+	commands []uint32
+}
+
+func (f *fakeConn) Protocol() string { return "fake" }
+func (f *fakeConn) Version() string  { return "fake" }
+func (f *fakeConn) ReadCommand() (uint32, []byte, error) {
+	if f.replies == 0 {
+		return 0, nil, io.EOF
+	}
+	f.replies--
+	return cmdMotorRes, []byte("{}"), nil
+}
+func (f *fakeConn) WriteCommand(cmd uint32, data []byte) error {
+	f.commands = append(f.commands, cmd)
+	f.written = append(f.written, data)
+	return nil
+}
+func (f *fakeConn) ReadPacket() ([]byte, []byte, error) { return nil, nil, errors.New("no media") }
+func (f *fakeConn) WritePacket([]byte, []byte) error    { return nil }
+func (f *fakeConn) RemoteAddr() net.Addr                { return &net.UDPAddr{} }
+func (f *fakeConn) SetDeadline(time.Time) error         { return nil }
+func (f *fakeConn) Close() error                        { return nil }
+
+func TestMotorSendsTheMotorRequest(t *testing.T) {
+	key := make([]byte, 32)
+	conn := &fakeConn{}
+	client := &Client{Conn: conn, key: key}
+	if err := client.Motor(3); err != nil {
+		t.Fatal(err)
+	}
+	if len(conn.commands) != 1 || conn.commands[0] != cmdEncoded {
+		t.Fatalf("commands = %v", conn.commands)
+	}
+	plain, err := crypto.Decode(conn.written[0], key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if binary.BigEndian.Uint32(plain) != cmdMotorReq || string(plain[4:]) != `{"operation":3}` {
+		t.Fatalf("motor request = %x %q", plain[:4], plain[4:])
+	}
+}
+
+func TestDiscardCommandsDrainsUntilTheSessionEnds(t *testing.T) {
+	conn := &fakeConn{replies: 25}
+	client := &Client{Conn: conn}
+	client.discardCommands()
+	if conn.replies != 0 {
+		t.Fatalf("%d replies were left unread", conn.replies)
+	}
+}
